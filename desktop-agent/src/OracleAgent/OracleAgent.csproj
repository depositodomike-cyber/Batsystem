<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Oracle Local Agent. SR-50: nenhum pacote NuGet de terceiros — só o SDK.
    Executável de console (CLI de pareamento) que, em `run`, vive na bandeja.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oracle-agent</AssemblyName>
    <RootNamespace>OracleAgent</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Exigido pelo gerador de LibraryImport (P/Invoke). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OracleAgent.Tests" />
  </ItemGroup>

</Project>
